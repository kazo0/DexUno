<Page x:Class="DexUno.Modern.Presentation.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding Title}" Style="{StaticResource PrimaryNavigationBarStyle}" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16" Spacing="16" MaxWidth="760">
        <utu:CardContentControl Style="{StaticResource ElevatedCardContentControlStyle}" HorizontalAlignment="Stretch">
          <StackPanel Padding="16" Spacing="8">
            <TextBlock Text="DexUno" Style="{StaticResource HeadlineSmall}" Foreground="{ThemeResource OnSurfaceBrush}" />
            <TextBlock Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}">
              <Run Text="Version" />
              <Run Text="{Binding AppVersion}" />
            </TextBlock>
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceBrush}"
                       Text="DexUno is a fast, offline Pokémon GO companion. Browse the Pokédex, compare moves and check type match-ups to make the best choices on your journey." />
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource BodyMedium}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       Text="Originally built for Windows 10 with UWP, now rebuilt on Uno Platform so it runs on Windows, macOS, Linux, iOS, Android and the web from a single code base." />
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" HorizontalAlignment="Stretch">
          <StackPanel Padding="16" Spacing="8">
            <TextBlock Text="Third party content" Style="{StaticResource CardSectionTitleStyle}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}">
              <Run Text="Pokémon pictures are made by" />
              <Hyperlink NavigateUri="http://theartificial.nl/pokemonicons/">The Artificial</Hyperlink>
              <Run Text="and licensed" />
              <Hyperlink NavigateUri="https://creativecommons.org/licenses/by/3.0/">CC-BY-3.0</Hyperlink><Run Text="." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}">
              <Run Text="Application icon made by" />
              <Hyperlink NavigateUri="http://theartificial.nl/pokemonicons/">Maicol Torti</Hyperlink>
              <Run Text="and licensed" />
              <Hyperlink NavigateUri="http://creativecommons.org/licenses/by/2.5/">CC-BY-2.5</Hyperlink><Run Text="." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource BodySmall}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       Text="This app is not associated with Nintendo in any way. Pokémon and Pokémon character names are trademarks of Nintendo." />
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
