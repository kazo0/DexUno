<UserControl x:Class="DexUno.Modern.Presentation.Shell"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DexUno.Modern.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      d:DesignHeight="300"
      d:DesignWidth="400">
  <Border Background="{ThemeResource BackgroundBrush}">
    <!--
      Platforms="None" keeps the toolkit from replicating the native splash image and colour here,
      so while the first page loads the only thing on screen is the pokeball, centred on the app background.
    -->
    <utu:ExtendedSplashScreen x:Name="Splash"
                              Platforms="None"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
      <utu:ExtendedSplashScreen.LoadingContentTemplate>
        <DataTemplate>
          <local:PokeballLoader Width="120"
                                Height="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
        </DataTemplate>
      </utu:ExtendedSplashScreen.LoadingContentTemplate>
    </utu:ExtendedSplashScreen>
  </Border>
</UserControl>
