<Page x:Class="Dexter.Presentation.PokedexPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Dexter.Presentation"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Grid x:Name="Root" utu:SafeArea.Insets="VisibleBounds">
    <!--
      TwoPaneView owns the master/detail split. Pane 1 is the list, pane 2 the detail. It shows both side by side
      from MinWideModeWidth, stacked from MinTallModeHeight, and on a spanned dual-screen device (the Foldable
      feature feeds it the hinge bounds) it splits along the hinge whatever the size — so the hinge never cuts
      through a pane. Below both thresholds only pane 1 shows and a selection navigates instead; see OnModeChanged.
      MinTallModeHeight is high on purpose: stacked panes are for hinged devices and very tall windows, not phones.
      MinWideModeWidth is low enough for an unfolded foldable's inner display (~850dp minus the nav rail), and the
      panes are equal halves so the layout is the same whether a hinge or the threshold produced the split.
    -->
    <TwoPaneView x:Name="Panes"
                 MinWideModeWidth="720"
                 MinTallModeHeight="1200"
                 Pane1Length="1*"
                 Pane2Length="1*"
                 PanePriority="Pane1"
                 WideModeConfiguration="LeftRight"
                 TallModeConfiguration="TopBottom"
                 ModeChanged="OnModeChanged">

      <!-- Master: search + sort tabs + list -->
      <TwoPaneView.Pane1>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <utu:NavigationBar Content="{Binding Title}" Style="{StaticResource PrimaryNavigationBarStyle}">
            <utu:NavigationBar.PrimaryCommands>
              <AppBarButton Label="Reverse order" Command="{Binding ToggleSortDirection}" Click="OnSortOrFilterChanged">
                <AppBarButton.Icon>
                  <FontIcon Glyph="&#xE8CB;" />
                </AppBarButton.Icon>
              </AppBarButton>
            </utu:NavigationBar.PrimaryCommands>
          </utu:NavigationBar>

          <TextBox Grid.Row="2"
                   Margin="16,8"
                   PlaceholderText="Search by name or number"
                   Style="{StaticResource OutlinedTextBoxStyle}"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   TextChanged="OnSortOrFilterChanged" />

          <!-- Coloured tabs sit flush under the red bar, like the Pokédex's red body around the screen. -->
          <utu:TabBar Grid.Row="1"
                      Style="{StaticResource ColoredTopTabBarStyle}"
                      SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                      SelectionChanged="OnSortOrFilterChanged">
            <utu:TabBarItem Content="By #" />
            <utu:TabBarItem Content="Name" />
            <utu:TabBarItem Content="Type" />
            <utu:TabBarItem Content="Max CP" />
          </utu:TabBar>

          <mvux:FeedView Grid.Row="3" Source="{Binding Items}">
            <DataTemplate>
              <!-- Items is a paginated feed: the repeater asks for the next page as the scroller nears the end. -->
              <ScrollViewer Style="{StaticResource DexListScrollViewerStyle}" Loaded="OnListScrollViewerLoaded">
                <ItemsRepeater ItemsSource="{Binding Data}"
                               ItemTemplate="{StaticResource PokemonListItemTemplate}"
                               utu:ItemsRepeaterExtensions.SelectionMode="Single"
                               utu:ItemsRepeaterExtensions.SelectedItem="{Binding Parent.Selected, Mode=TwoWay}"
                               utu:ItemsRepeaterExtensions.SupportsIncrementalLoading="True"
                               utu:CommandExtensions.Command="{Binding Parent.SelectPokemon}" />
              </ScrollViewer>
            </DataTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <TextBlock Text="No Pokémon match your search."
                           Style="{StaticResource BodyLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,32,0,0" />
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
          </mvux:FeedView>
        </Grid>
      </TwoPaneView.Pane1>

      <!-- Detail pane; the view's own FeedView shows the placeholder until a Pokémon is selected -->
      <TwoPaneView.Pane2>
        <Grid x:Name="DetailPane"
              Background="{ThemeResource SurfaceBrush}"
              BorderBrush="{ThemeResource OutlineVariantBrush}"
              BorderThickness="1,0,0,0">
          <local:PokemonDetailView DataContext="{Binding Detail}" />
        </Grid>
      </TwoPaneView.Pane2>
    </TwoPaneView>
  </Grid>
</Page>
