<UserControl x:Class="Dexter.Presentation.PokemonDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!-- DetailRoot carries the view model so nested item templates can reach its commands by ElementName. -->
  <Grid x:Name="DetailRoot">
    <mvux:FeedView Source="{Binding Details}">
      <DataTemplate>
        <ScrollViewer>
          <StackPanel Padding="16" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">

            <!-- Hero card -->
            <utu:CardContentControl Style="{StaticResource ElevatedCardContentControlStyle}" HorizontalAlignment="Stretch">
              <Grid Padding="16">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Previous / title / next -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource IconButtonStyle}"
                          Command="{Binding Parent.Previous}"
                          IsEnabled="{Binding Data.HasPrevious}"
                          ToolTipService.ToolTip="Previous Pokémon">
                    <FontIcon Glyph="&#xE76B;" />
                  </Button>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Data.Pokemon.DisplayName}"
                               Style="{StaticResource HeadlineSmall}"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource LabelMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               HorizontalAlignment="Center">
                      <Run Text="#" /><Run Text="{Binding Data.Pokemon.DexNumber}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="2"
                          Style="{StaticResource IconButtonStyle}"
                          Command="{Binding Parent.Next}"
                          IsEnabled="{Binding Data.HasNext}"
                          ToolTipService.ToolTip="Next Pokémon">
                    <FontIcon Glyph="&#xE76C;" />
                  </Button>
                </Grid>

                <Image Grid.Row="1"
                       Width="200"
                       Height="200"
                       Margin="0,8"
                       Stretch="Uniform"
                       Source="{Binding Data.Pokemon.DexNumber, Converter={StaticResource DexNumberToImage}}" />

                <ItemsControl Grid.Row="2"
                              HorizontalAlignment="Center"
                              ItemsSource="{Binding Data.Pokemon.Types}"
                              ItemTemplate="{StaticResource TypeBadgeTemplate}"
                              ItemsPanel="{StaticResource HorizontalBadgesPanel}" />

                <!-- Quick facts -->
                <Grid Grid.Row="3" Margin="0,16,0,0" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Data.Pokemon.Cp.Max}" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource DexAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="MAX CP" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center">
                      <Run Text="{Binding Data.Pokemon.FleeRate}" /><Run Text="%" />
                    </TextBlock>
                    <TextBlock Text="FLEE" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center">
                      <Run Text="{Binding Data.Pokemon.CatchRate}" /><Run Text="%" />
                    </TextBlock>
                    <TextBlock Text="CATCH" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Data.Pokemon.CandiesToEvolve}" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="CANDIES" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Grid>
            </utu:CardContentControl>

            <!-- Base stats -->
            <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" HorizontalAlignment="Stretch">
              <StackPanel Padding="16" Spacing="12">
                <TextBlock Text="Base stats" Style="{StaticResource CardSectionTitleStyle}" />
                <ContentControl Content="{Binding Data.Attack}" ContentTemplate="{StaticResource AttackGaugeTemplate}" HorizontalContentAlignment="Stretch" />
                <ContentControl Content="{Binding Data.Defense}" ContentTemplate="{StaticResource DefenseGaugeTemplate}" HorizontalContentAlignment="Stretch" />
                <ContentControl Content="{Binding Data.Stamina}" ContentTemplate="{StaticResource StaminaGaugeTemplate}" HorizontalContentAlignment="Stretch" />
              </StackPanel>
            </utu:CardContentControl>

            <!-- Evolutions -->
            <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding Data.HasEvolutions, Converter={StaticResource Visibility}}">
              <StackPanel Padding="16" Spacing="8">
                <TextBlock Text="Evolutions" Style="{StaticResource CardSectionTitleStyle}" />
                <ItemsControl ItemsSource="{Binding Data.EvolutionLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ItemsControl ItemsSource="{Binding Stages}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <FontIcon Glyph="&#xE72A;"
                                        Margin="4,0"
                                        FontSize="14"
                                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsFirst, Converter={StaticResource Visibility}, ConverterParameter=Invert}" />
                              <Button Style="{StaticResource TextButtonStyle}"
                                      Foreground="{ThemeResource DexAccentBrush}"
                                      Command="{Binding DataContext.SelectEvolution, ElementName=DetailRoot}"
                                      CommandParameter="{Binding Pokemon}"
                                      Padding="8"
                                      MinHeight="0">
                                <StackPanel Spacing="4">
                                  <Image Width="72"
                                         Height="72"
                                         Stretch="Uniform"
                                         Source="{Binding Pokemon.DexNumber, Converter={StaticResource DexNumberToImage}}" />
                                  <TextBlock Text="{Binding Pokemon.DisplayName}"
                                             Style="{StaticResource LabelMedium}"
                                             Foreground="{ThemeResource OnSurfaceBrush}"
                                             HorizontalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </utu:CardContentControl>

            <!-- Moves -->
            <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" HorizontalAlignment="Stretch">
              <StackPanel Padding="0,16">
                <TextBlock Text="Quick moves" Style="{StaticResource CardSectionTitleStyle}" Margin="16,0,16,8" />
                <ItemsRepeater ItemsSource="{Binding Data.MoveSet.QuickMoves}"
                               ItemTemplate="{StaticResource MoveListItemTemplate}"
                               utu:CommandExtensions.Command="{Binding Parent.SelectMove}" />
                <TextBlock Text="Charge moves" Style="{StaticResource CardSectionTitleStyle}" Margin="16,16,16,8" />
                <ItemsRepeater ItemsSource="{Binding Data.MoveSet.ChargeMoves}"
                               ItemTemplate="{StaticResource MoveListItemTemplate}"
                               utu:CommandExtensions.Command="{Binding Parent.SelectMove}" />
              </StackPanel>
            </utu:CardContentControl>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>

      <!-- Shown in the master/detail pane until a Pokémon is selected -->
      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <TextBlock Text="Select a Pokémon to see its details"
                     Style="{StaticResource BodyLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
    </mvux:FeedView>
  </Grid>
</UserControl>
