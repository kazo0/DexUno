<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <!--
    The palette itself is generated from the three Pokédex seed colours set on ThemeColors in App.xaml
    (body red, lens blue, button green). This file only holds the deliberate deviations from what the
    seeds produce; it is applied on top of the generated palette (ThemeColors.OverrideSource).

    Dark theme: the generator lightens Primary to tone 80 (a pale pink-red) as Material 3 prescribes, but the
    app's chrome (PrimaryNavigationBarStyle, ColoredTopTabBarStyle, the Shell root) must stay the actual
    Pokédex red at night too, so Primary is pinned to the body red with white on top. Small red *text* on dark
    surfaces uses DexAccentBrush (AppResources.xaml) instead of PrimaryBrush because this red is only ~3:1 there.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light" />
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#DC0A2D</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
